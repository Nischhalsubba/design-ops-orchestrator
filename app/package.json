{
  "name": "design-ops-orchestrator",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "description": "A modular Gulp 5 pipeline for design tokens, content, media, motion, accessibility audits, and front-end release automation.",
  "author": "Nischhal Raj Subba",
  "license": "MIT",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "start": "gulp",
    "build": "gulp build --production",
    "deploy": "gulp deploy",
    "lint": "npm run lint:styles && gulp lint",
    "lint:styles": "stylelint \"src/styles/**/*.scss\"",
    "audit": "gulp audit",
    "tokens": "gulp tokens",
    "todo": "gulp todo",
    "release": "gulp release --type minor",
    "test:a11y": "gulp audit:a11y",
    "test:perf": "gulp audit:perf",
    "check": "npm run lint && npm run build"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "4.12.1",
    "@typescript-eslint/parser": "8.65.0",
    "autoprefixer": "^10.4.19",
    "browser-sync": "3.0.4",
    "chalk": "^5.3.0",
    "critical": "8.0.0",
    "cssnano": "^6.1.2",
    "del": "^7.1.0",
    "dotenv": "^16.4.5",
    "eslint": "8.57.1",
    "fancy-log": "^2.0.0",
    "front-matter": "^4.0.2",
    "gulp": "^5.0.0",
    "gulp-brotli": "^3.0.0",
    "gulp-bump": "^3.2.0",
    "gulp-cached": "^1.1.1",
    "gulp-data": "^1.3.1",
    "gulp-dependents": "^1.2.5",
    "gulp-esbuild": "^0.14.0",
    "gulp-filelist": "^1.1.0",
    "gulp-filter": "^9.0.0",
    "gulp-git": "^2.10.1",
    "gulp-group-css-media-queries": "^1.2.2",
    "gulp-header": "^2.0.9",
    "gulp-if": "^3.0.0",
    "gulp-inject": "^5.0.5",
    "gulp-jsonmin": "^1.2.0",
    "gulp-postcss": "^10.0.0",
    "gulp-pug": "^5.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-rev": "^11.0.0",
    "gulp-rev-delete-original": "^0.2.3",
    "gulp-rtlcss": "^2.0.0",
    "gulp-sass": "^5.1.0",
    "gulp-sitemap": "^7.1.0",
    "gulp-size": "^5.0.0",
    "gulp-svg-sprite": "^2.0.3",
    "gulp-tag-version": "^1.3.0",
    "gulp-terser": "^2.1.0",
    "gulp-zip": "^6.0.0",
    "html-minifier-terser": "7.2.0",
    "markdown-it": "^14.0.0",
    "postcss": "8.5.25",
    "postcss-assets": "^6.0.0",
    "postcss-preset-env": "^9.3.0",
    "postcss-pxtorem": "^6.1.0",
    "postcss-sorting": "^8.0.0",
    "puppeteer": "25.4.0",
    "sass": "^1.75.0",
    "sharp": "0.35.3",
    "stylelint": "17.14.1",
    "stylelint-config-standard-scss": "17.0.0",
    "through2": "^4.0.2",
    "w3c-html-validator": "2.2.2",
    "yargs": "^17.7.2"
  },
